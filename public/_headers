# Cloudflare Workers static assets: never let the HTML shell go stale in in-app browsers;
# hashed assets are immutable; data files refresh within minutes.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/levels/*
  Cache-Control: public, max-age=300
/models/*
  Cache-Control: public, max-age=86400
