{
  // Cloudflare Workers "static assets" deploy: the whole dist/ folder is served
  // as static files, no Worker code. Workers Builds runs `npm run build` then
  // `npx wrangler deploy` on every push; `npm run deploy` does the same locally.
  "name": "hdbreeze",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
